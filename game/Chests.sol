    function setCoordinator(
        address _vrfCoordinator
    ) external override onlyOwner {
        if (_vrfCoordinator == address(0)) {
            revert ZeroAddress();
        }
        s_vrfCoordinator = IVRFCoordinatorV2Plus(_vrfCoordinator);

        emit CoordinatorSet(_vrfCoordinator);
    }

    modifier onlyCoordinator() {
        if (msg.sender != address(s_vrfCoordinator)) {
            revert OnlyCoordinator(
                msg.sender,
                address(s_vrfCoordinator)
            );
        }
        _;
    }
}

interface IGenesisCrystal {
    function transferFrom(address from, address to, uint256 value) external;
}

interface IAssist {
    function mint(address _user,uint256 _toolIds,uint256 _assistLevel,uint256 _growth,uint256 _skillLevel,uint256 _initTokenId) external;
}

interface IPassportNFT {
    function mintBatch(address _user,uint256 quantity,uint256 _initTokenId) external;
}

contract Chests is ERC721, ReentrancyGuard, VRFConsumerBaseV2Plus {
    using Counters for Counters.Counter;
    using Strings for uint256;

    Counters.Counter private _tokenIdTracker;

    event Mint(address indexed from, address indexed to, uint256 value);
    event Proxy(UserInfo userInfo);
    event RequestFulfilled(uint256 requestId, uint256 randomWord);
    event RequestRandomWordsEvent(uint256 requestId);
    event CalculateResultEvent(address indexed user, uint256 indexed orderId, uint256 indexed chestTokenId, address contractAddress, uint256 randomValue, uint256 types, uint256 count, uint256 finalValue);

    string public baseTokenURI = "https://ivory-worrying-seahorse-252.mypinata.cloud/ipfs/bafybeie7ivl5ss3eh33lyzkginnz2cj3n4xf5w24uakyal7rkvrmtjy3eq/";
    string public constant baseExtension = ".json";

    bytes32 public immutable keyHash;

    uint256 currentOrderId;
    uint256 private _total;
    uint256 public constant TOTAL_TOKENID = 10_0000;
    uint256 public s_subscriptionId;
    uint256 private nextKey = 1;
    uint32 private callbackGasLimit = 100_000;
    uint16 private requestConfirmations = 3;

    IGenesisCrystal public genesisCrystalContract;
    IAssist public assistNFTContract;
    IPassportNFT public passportNFTContract;

    struct UserInfo {
        uint256 orderId;
        address user;
        uint256 chestTokenId;
        uint256 requestIdValue;
        bool isExist;
    }
    
    struct RequestStatus {
        bool fulfilled;
        bool exists;
        bool used;
        uint256 randomWord;
    }

    struct ResultInfo {
        address contractAddress;
        uint256 randomValue;
        uint256 nftType;
        uint256 nftCount;
        uint256 finalValue;
    }

    mapping(address => mapping(uint256 => bool)) private _tokenIdExists;
    mapping(uint256 => mapping(uint256 => uint256)) private bind;
    mapping(address => bool) private authorizedMap;
    mapping(uint256 => UserInfo) private orderInfo;
    mapping(uint256 => RequestStatus) private s_requests;
    mapping(uint256 => uint256[]) private dataMap;
    mapping(uint256 => bool) private isRequestId;
    mapping(uint256 => uint256) private oidToRid;
    mapping(uint256 => uint256) private ridToOid;
    mapping(uint256 => uint256) private cidToOid;

    constructor(
        uint256 subscriptionId,
        address genesisCrystalContract_,
        address assistNFTContract_,
        address passportNFTContract_
    ) ERC721("Chest", "CET") VRFConsumerBaseV2Plus(0xDA3b641D438362C440Ac5458c57e00a712b66700) {
        keyHash = 0x8596b430971ac45bdf6088665b9ad8e8630c9d5049ab54b14dff711bee7c0e26;
        require(subscriptionId != 0 && genesisCrystalContract_ != address(0) && assistNFTContract_ != address(0) && passportNFTContract_ != address(0), "can not be zero");

        s_subscriptionId = subscriptionId;
        genesisCrystalContract = IGenesisCrystal(genesisCrystalContract_);
        assistNFTContract = IAssist(assistNFTContract_);
        passportNFTContract = IPassportNFT(passportNFTContract_);
    }

    function initialize(uint256[][] memory arrays) external onlyOwner nonReentrant returns (uint256[] memory) {
        uint256[] memory keys = new uint256[](arrays.length);
        for (uint256 i = 0; i < arrays.length; i++) {
            uint256 key = nextKey;
            dataMap[key] = arrays[i];
            keys[i] = key;
            nextKey++;
        }
        return keys;
    }

    function mintChest(address _user,uint256 _initTokenId) external onlyOwner nonReentrant {
        require(_user != address(0), "Invalid user address");
        require(bind[_initTokenId][TOTAL_TOKENID] < TOTAL_TOKENID, "Maximum limit reached");

        uint256 _tokenId = _initTokenId + bind[_initTokenId][TOTAL_TOKENID] + 1;
        require(_tokenId <= _initTokenId + TOTAL_TOKENID + 1, "Token ID exceeds limit");

        _mint(_user, _tokenId);
        _tokenIdTracker.increment();
        _total += 1;

        _tokenIdExists[_user][_tokenId] = true;
        bind[_initTokenId][TOTAL_TOKENID]++;

        emit Mint(address(0), _user, _tokenId);
    }

    function proxy(uint256 _chestTokenId) external nonReentrant {
        require(ownerOf(_chestTokenId) == msg.sender, "you doesn't own this chestTokenId");

        _transfer(msg.sender, address(this), _chestTokenId);

        uint256 newOrderId = currentOrderId + 1;

        UserInfo memory newUserInfo = UserInfo({
            orderId: newOrderId,
            user: msg.sender,
            chestTokenId: _chestTokenId,
            requestIdValue: 0,
            isExist: true
        });
    
        cidToOid[_chestTokenId] = newOrderId;
        orderInfo[newOrderId] = newUserInfo;
        currentOrderId = newOrderId;

        _tokenIdExists[msg.sender][_chestTokenId] = false;
        _tokenIdExists[address(this)][_chestTokenId] = true;
        
        emit Proxy(newUserInfo);
    }

    function requestRandomWords(uint256 _orderId) external onlyOwner nonReentrant returns (uint256 requestId) {
        require(orderInfo[_orderId].isExist, "The order doesn't exist");
        require(!isRequestId[_orderId], "The order can't be requested again");
        requestId = s_vrfCoordinator.requestRandomWords(
            VRFV2PlusClient.RandomWordsRequest({
                keyHash: keyHash,
                subId: s_subscriptionId,
                requestConfirmations: requestConfirmations,
                callbackGasLimit: callbackGasLimit,
                numWords: 1,
                extraArgs: VRFV2PlusClient._argsToBytes(
                    VRFV2PlusClient.ExtraArgsV1({
                        nativePayment: true
                    })
                )
            })
        );
        
        s_requests[requestId] = RequestStatus({
            randomWord: 0,
            exists: true,
            fulfilled: false,
            used: false
        });

        isRequestId[_orderId] = true;
        oidToRid[_orderId] = requestId;
        ridToOid[requestId] = _orderId;

        require(s_requests[requestId].exists, "request not found");
        s_requests[requestId];
        orderInfo[_orderId].requestIdValue = requestId;

        emit RequestRandomWordsEvent(requestId);

        return requestId;
    }

    function fulfillRandomWords(uint256 _requestId,uint256[] calldata _randomWords) internal override {
        require(s_requests[_requestId].exists, "request not found");
        require(_randomWords.length > 0, "no random words returned");

        uint256 randomValue = _randomWords[0];
        s_requests[_requestId].fulfilled = true;
        s_requests[_requestId].randomWord = (randomValue % 10000) + 1;
        emit RequestFulfilled(_requestId, s_requests[_requestId].randomWord);
    }

    function calculateResult(uint256 _orderId) external onlyOwner nonReentrant returns(ResultInfo memory) {
        UserInfo storage userInfo = orderInfo[_orderId];
        require(userInfo.isExist, "The order doesn't exist");
		
        uint256 requestId = oidToRid[_orderId];
        RequestStatus storage request = s_requests[requestId];

        require(request.fulfilled, "Random number not fulfilled yet");
        require(!request.used, "Result for this request has already been calculated");

        uint256 randomValue = s_requests[requestId].randomWord;
        uint256 chestTokenId = userInfo.chestTokenId;
        uint256 value = (chestTokenId / 100000) % 100;
        uint256 index0 = chestTokenId / 10000000;
        uint256 resultValue = value + getInitializeData(1)[index0 - 1];
        uint256[] memory thresholds = getInitializeData(resultValue);

        require(thresholds.length % 3 == 0, "Invalid thresholds length");

        (uint256 nft_type, uint256 nft_count) = determineNftTypeAndCount(randomValue,thresholds);

        require(ownerOf(userInfo.chestTokenId) == address(this), "This chest doesn't belong to this contract");

        _transfer(address(this), address(0), userInfo.chestTokenId);
        
        ResultInfo memory resultInfo;

        if (nft_type == 1) {
            handleGenesisCrystal(userInfo.user, nft_count);
            resultInfo = ResultInfo({
                contractAddress: address(genesisCrystalContract),
                randomValue: randomValue,
                nftType: nft_type,
                nftCount: nft_count,
                finalValue: nft_count * 1e18
            });
        } else if (nft_type >= 10 && nft_type <= 999) {
            handlePassportNFT(userInfo.user, nft_type);
            resultInfo = ResultInfo({
                contractAddress: address(passportNFTContract),
                randomValue: randomValue,
                nftType: nft_type,
                nftCount: nft_count,
                finalValue: nft_type * 1000
            });
        } else {
            handleAssistNFT(userInfo.user, nft_type);
            resultInfo = ResultInfo({
                contractAddress: address(assistNFTContract),
                randomValue: randomValue,
                nftType: nft_type,
                nftCount: nft_count,
                finalValue: nft_type
            });
        }

        request.used = true;
        userInfo.isExist = false;
        _tokenIdExists[address(this)][chestTokenId] = false;
             
        emit CalculateResultEvent(
            userInfo.user,
            _orderId,
            userInfo.chestTokenId,
            resultInfo.contractAddress,
            resultInfo.randomValue,
            resultInfo.nftType,
            resultInfo.nftCount,
            resultInfo.finalValue
        );

        return resultInfo;
    }

    function determineNftTypeAndCount(uint256 randomValue,uint256[] memory thresholds) private pure returns (uint256 nft_type, uint256 nft_count) {
        uint256 cumulativeRange = 0;
        for (uint256 i = 0; i < thresholds.length; i += 3) {
            require(
                i + 2 < thresholds.length,
                "Thresholds array out of bounds"
            );
            cumulativeRange += thresholds[i + 2];
            if (randomValue <= cumulativeRange) {
                return (thresholds[i], thresholds[i + 1]);
            }
        }
        revert("Random value exceeds threshold ranges");
    }

    function handleGenesisCrystal(address _user, uint256 nft_count) private {
        genesisCrystalContract.transferFrom(
            owner(),
            _user,
            nft_count * 1e18
        );
    }

    function handlePassportNFT(address _user, uint256 nft_type) private {
        uint256 passportIntiTokenId = nft_type * 1000;
        passportNFTContract.mintBatch(_user, 1, passportIntiTokenId);
    }

    function handleAssistNFT(address _user, uint256 nft_type) private {
        uint256 digit = Math.log10(nft_type);
        uint256 assistLevel = digit > 5 ? 1 : ((6 - digit) * 2 + 1);
        uint256 skilllevel = digit > 5 ? 1 : ((6 - digit) * 5 + 1);
        uint256 identification = nft_type / 10 ** (digit - 1);
        uint256 toolId = 1100 +
            (identification / 10) *
            100 +
            (7 - digit) *
            20 +
            (identification % 10) -
            1;

        assistNFTContract.mint(
            _user,
            toolId,
            assistLevel,
            1000,
            skilllevel,
            nft_type
        );
    }

    function setGenesisCrystalContract(address _contract) external onlyOwner returns (bool) {
        require(_contract != address(0), "Invalid contract address.");
        genesisCrystalContract = IGenesisCrystal(_contract);
        return true;
    }

    function setAssistContract(address _contract) external onlyOwner {
        require(_contract != address(0), "Invalid contract address.");
        assistNFTContract = IAssist(_contract);
    }

    function setPassportNFTContract(address _contract) external onlyOwner returns (bool) {
        require(_contract != address(0), "Invalid contract address.");
        passportNFTContract = IPassportNFT(_contract);
        return true;
    }

    function setRequestConfirmations(uint16 _requestConfirmations) external onlyOwner {
        requestConfirmations = _requestConfirmations;
    }

    function setCallbackGasLimit(uint32 _callbackGasLimit) external onlyOwner {
        callbackGasLimit = _callbackGasLimit;
    }

    function transferFrom(address from, address to, uint256 tokenId) public override {
        if (to == address(0)) {
            revert ERC721InvalidReceiver(address(0));
        }
      
        address previousOwner = _update(to, tokenId, _msgSender());
        if (previousOwner != from) {
            revert ERC721IncorrectOwner(from, tokenId, previousOwner);
        }

        _tokenIdExists[from][tokenId] = false;
        _tokenIdExists[to][tokenId] = true;
    }

    function safeTransferFrom(address from, address to, uint256 tokenId) public override {
        safeTransferFrom(from, to, tokenId, "");
    }

    function safeTransferFrom(address from, address to, uint256 tokenId, bytes memory data) public override {
        transferFrom(from, to, tokenId);
        ERC721Utils.checkOnERC721Received(_msgSender(), from, to, tokenId, data);
    }

    function addElementToArray(uint256 newValue) external onlyOwner nonReentrant {
        dataMap[1].push(newValue);
    }

    function updateBaseTokenURI(string memory newBaseTokenURI) external onlyOwner {
        baseTokenURI = newBaseTokenURI;
    }

    function tokenURI(uint256 tokenId) public view override returns (string memory) {
        require(_exists(tokenId), "Token ID does not exist");
        uint256 temp = tokenId / 100000 * 100000;
        return string(abi.encodePacked(baseTokenURI, temp.toString(), baseExtension));
    }

    function get_s_requests(uint256 _requestId) external view returns (bool fulfilled, bool exists, bool used, uint256 randomWord) {
        RequestStatus memory request = s_requests[_requestId];
        return (request.fulfilled, request.exists, request.used, request.randomWord);
    }

    function getOidToRid(uint256 _orderId) external view returns (uint256) {
        return oidToRid[_orderId];
    }

    function getRidToOid(uint256 _requestId) external view returns (uint256) {
        return ridToOid[_requestId];
    }

    function getCidToOid(uint256 _chestTokenId) external view returns(uint256) {
        return cidToOid[_chestTokenId];
    }

    function getInitializeData(uint256 key) public view returns (uint256[] memory) {
        require(dataMap[key].length > 0, "Key does not exist or data is empty");
        return dataMap[key];
    }

    function getUserInfo(uint256 _orderId) external view returns (UserInfo memory) {
        return orderInfo[_orderId];
    }

    function tokenIdExists(address _user,uint256 tokenId) external view returns (bool) {
        require(_user != address(0), "user can't be zero address");
        return _tokenIdExists[_user][tokenId];
    }

    function _exists(uint256 tokenId) private view returns (bool) {
        address owner = ownerOf(tokenId);
        return owner != address(0);
    }
}