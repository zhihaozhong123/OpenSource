{
  "name": "CherrySwap",
  "version": "1.0.0",
  "scripts": {
    "codegen": "graph codegen --output-dir src/types/",
    "build": "graph build",
    "create-local": "graph create cherryswap/subgraph7 --node http://127.0.0.1:8020",
    "deploy-local": "graph deploy cherryswap/subgraph7 --debug --ipfs http://127.0.0.1:5001 --node http://127.0.0.1:8020",
    "deploy": "graph deploy cherryswap/subgraph --ipfs https://api.thegraph.com/ipfs/ --node https://api.thegraph.com/deploy/ --debug",
    "deploy-staging": "graph deploy $THE_GRAPH_GITHUB_USER/$THE_GRAPH_SUBGRAPH_NAME /CherrySwap --ipfs https://api.staging.thegraph.com/ipfs/ --node https://api.staging.thegraph.com/deploy/",
    "watch-local": "graph deploy cherryswap/subgraph --watch --debug --node http://127.0.0.1:8020/ --ipfs http://127.0.0.1:5001",
    "remove-local": "graph remove --node http://localhost:8020/ cherryswap/subgraph7"
  },
  "devDependencies": {
    "@graphprotocol/graph-cli": "^0.19.0",
    "@graphprotocol/graph-ts": "^0.19.0",
    "@typescript-eslint/eslint-plugin": "^4.13.0",
    "@typescript-eslint/parser": "^4.13.0",
    "eslint": "^7.17.0",
    "eslint-config-prettier": "^7.1.0",
    "prettier": "^2.2.1",
    "typescript": "^4.1.3"
  },
  "dependencies": {
    "geth": "^0.4.0"
  }
}
